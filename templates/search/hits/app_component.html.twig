{# One component in the search results. `hit` is the matched Component (or its array form). #}
{% set id = hit.id %}
<a class="card card-link card-link-pop h-100" href="{{ path('component_show', {componentId: id}) }}">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <h3 class="card-title mb-0">{{ hit.name ?? hit.composerName ?? id }}</h3>
            {% if hit.kind %}<span class="badge bg-blue-lt">{{ hit.kind.name ?? hit.kind }}</span>{% endif %}
        </div>
        <div class="text-secondary small mb-2">{{ hit.composerName ?? '' }}</div>
        <p class="text-secondary mb-0">{{ (hit.description ?? '')|u.truncate(140, '…') }}</p>
    </div>
</a>
