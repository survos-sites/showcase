{% extends 'component/base.html.twig' %}
{% block page_name %}Libraries{% endblock %}
{% block component_body %}
    <div class="card"><div class="list-group list-group-flush">
        {% for name in component.dependencies %}
            {% set other = known[name] ?? null %}
            <div class="list-group-item d-flex justify-content-between align-items-center">
                {% if other %}<a href="{{ path('component_show', other.rp) }}">{{ name }}</a>{% else %}<span>{{ name }}</span>{% endif %}
                <span class="text-secondary small">{{ component.composerJson.require[name] ?? '' }}</span>
            </div>
        {% else %}
            <div class="list-group-item text-secondary">No package requirements.</div>
        {% endfor %}
    </div></div>
    {% if component.extensions %}<p class="mt-3 text-secondary">PHP extensions: {{ component.extensions|join(', ') }}</p>{% endif %}
{% endblock %}
